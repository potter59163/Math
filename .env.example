# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (project region: Southeast Asia / Singapore)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # teacher magic-link auth only
SUPABASE_SERVICE_ROLE_KEY=           # server only

# Student session cookie signing (long random string)
SESSION_SECRET=

# LLM director: none | gemini | anthropic | openai
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=4000

# 1 = seed demo class + simulated students, rules mode
DEMO_MODE=0
