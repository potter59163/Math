# Copy to .env.local and fill in. Never commit .env.local. docs/SETUP.md explains where each one comes from.
# With the database or Google values empty the app still runs, for guests only.

# MongoDB Atlas connection string, password included. Anyone holding it can read every student's data.
MONGODB_URI=
# Leave empty for the database named kidma.
MONGODB_DB=

# Google sign-in: an OAuth client of type Web application. Never add NEXT_PUBLIC_ to the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tutor: none | anthropic. With none, or with no key, the rules decide everything.
LLM_PROVIDER=none
# Leave empty for the fast default, claude-haiku-5-5.
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=4000
