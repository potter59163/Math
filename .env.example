# Copy to .env.local and fill in. Never commit .env.local. docs/SETUP.md explains where each one comes from.
# With the Supabase values empty the app still runs, for guests only.

# Supabase (project region: Southeast Asia / Singapore)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never add NEXT_PUBLIC_ to this one.
SUPABASE_SERVICE_ROLE_KEY=

# LLM director: none | gemini | anthropic | openai. With none, or with no key, the rules decide everything.
LLM_PROVIDER=none
# Leave empty for the provider's fast default (claude-haiku-5-5, gemini-2.5-flash or gpt-5-mini).
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=4000
