# Committed on purpose, and read by `next build` for production and preview deployments. This repository
# is public: never put a secret here. Secrets go in Vercel's Environment Variables, and any value set there
# wins over this file.

# Topics offered to students (docs/VECTORS.md). To switch vectors off again, set NEXT_PUBLIC_TOPICS=matrix
# in Vercel and redeploy, or change it here.
NEXT_PUBLIC_TOPICS=matrix,vector
